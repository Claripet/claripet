{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "claripet",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Non-secret runtime config. These are read via process.env inside the
	// Worker, where .env.local does not exist — anything the server reads at
	// request time must be a var or a secret, or it is simply undefined.
	// RAJAONGKIR_ORIGIN_ID is a public RajaOngkir district ID (Jakarta), not a
	// credential, so it lives here rather than in `wrangler secret`.
	"vars": {
		"RAJAONGKIR_ORIGIN_ID": "17547"
	},
	"images": {
		// Enable Next.js Image Optimization via Cloudflare's built-in binding
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "395cdaff022748a8bfa1ec01ee81bc03",
			"remote": true
		}
	]
	// R2-backed incremental cache is intentionally not configured yet — it needs
	// an R2 bucket created first (`wrangler r2 bucket create cache`) plus a
	// self-reference service binding. Without it, ISR/data-cache entries just
	// don't persist across requests, which is fine to start with.
	// See https://opennext.js.org/cloudflare/caching to add it later.
}